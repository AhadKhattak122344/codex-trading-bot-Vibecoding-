# ===========================================
# SPY TRADING BOT - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to '.env' and fill in your keys
# DO NOT share your .env file with anyone!

# Reddit API Credentials
# Get these from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=SPYTradingBot/1.0

# Twitter/X API Credentials  
# Get these from: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# News API Credentials
# Get these from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Alpha Vantage (backup stock data)
# Get this from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Ollama Configuration (usually no changes needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Trading Configuration
# Set to 'paper' for practice, 'live' for real trading (USE WITH CAUTION!)
TRADING_MODE=paper
INITIAL_CAPITAL=10000
MAX_POSITION_SIZE=0.25
STOP_LOSS_PERCENT=0.02
TAKE_PROFIT_PERCENT=0.05

# Risk Management
MAX_DAILY_TRADES=10
MIN_CONFIDENCE_SCORE=0.6

# App Settings
DEBUG_MODE=false
LOG_LEVEL=INFO
